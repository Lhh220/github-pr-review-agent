# Copy to .env for local Compose. Defaults are for a loopback-only demo.
# Without model/GitHub credentials, /healthz and /admin work; PR review does not.
APP_ENV=local
APP_PORT=8080
ADMIN_TOKEN=local-review-token
MYSQL_PASSWORD=review-local
MYSQL_ROOT_PASSWORD=root-local
RABBITMQ_PASSWORD=review-local
AGENT_MODE=tool_calling
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Compose dotenv supports single-quoted multiline values for the PEM key.
GITHUB_APP_PRIVATE_KEY=
# Alternatively, use a token for your own test repository:
GITHUB_TOKEN=
